---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import PentagramGrid from '../components/PentagramGrid.astro';
import ImageOne from '../assets/blog-placeholder-1.jpg';
import ImageTwo from '../assets/blog-placeholder-2.jpg';
import ImageThree from '../assets/blog-placeholder-3.jpg';
import ImageFour from '../assets/blog-placeholder-4.jpg';
import ImageFive from '../assets/blog-placeholder-5.jpg';
import ImageSix from '../assets/blog-placeholder-about.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const stories = [
	{
		title: 'Chronicle of a War Foretold',
		description: 'Investigative long-form visual story on prediction markets and conflict timing.',
		href: '/stories/chronicle/',
		image: ImageOne,
	},
	{
		title: 'Cass Art King\'s Cross Store',
		description:
			'Environmental graphics and strategy for a materials-first flagship experience.',
		href: '/blog/second-post/',
		image: ImageTwo,
	},
	{
		title: 'London Design Festival 2026',
		description: 'Visual identity and campaign system for a major design event.',
		href: '/blog/third-post/',
		image: ImageThree,
	},
	{
		title: 'Women+ on the Edge of Democracy',
		description: 'Identity for a collection of short plays on civic life.',
		href: '/about/',
		image: ImageFour,
	},
	{
		title: 'Xsolla',
		description:
			'Brand identity and narrative framework for a global gaming technology platform.',
		href: '/research/',
		image: ImageFive,
	},
	{
		title: 'La Nouvelle Maison',
		description: 'Book design tracing restoration and history of the house by Van de Velde.',
		href: '/bio/',
		image: ImageSix,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="grid-page">
		<Header />
		<main>
			<PentagramGrid items={stories} />
		</main>
	</body>
</html>
