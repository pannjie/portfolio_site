---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<!-- Without JavaScript, show the full words instead of the collapsed start state -->
		<noscript><style>.home-blank .slide { width: auto !important; }</style></noscript>
	</head>
	<body class="grid-page">
		<Header />
		<main>
			<section class="home-blank" aria-label="Homepage intro">
				<h1>Hi, you have reached PJ, a journalist/writer based in <span>London<span class="slide">&nbsp;+ Singapore</span></span>. I <span class="font">write stories</span>, build <span class="interactive">interactives</span>, and obsess over <span class="data"><span class="slide slide-left">&#123;</span>data<span class="slide">&#125;</span></span></h1>
				<p>
					<span class="pr-7"> Reach me at </span>
					<!-- Same filled box as the site's labels and the CV download buttons -->
					<a
						href="mailto:pannjie@gmail.com"
						class="ml-1 inline-block bg-ink px-[0.45rem] py-[0.1rem] align-baseline font-pixel text-[1.15rem] leading-[1.2] tracking-[0.02em] text-white! no-underline transition-colors hover:bg-black hover:text-white! focus-visible:bg-black focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-ink"
						>pannjie@gmail.com</a
					>
				</p>
				<p class="lower">
					<span class="pr-1"> Or maybe  </span>
					<!-- Same filled box as the site's labels and the CV download buttons -->
					<a
						href="https://www.linkedin.com/in/pan-jie-a70173b2/"
						class="ml-1 inline-block bg-ink px-[0.45rem] py-[0.1rem] align-baseline font-pixel text-[1.15rem] leading-[1.2] tracking-[0.02em] text-white! no-underline transition-colors hover:bg-black hover:text-white! focus-visible:bg-black focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-ink"
						>linkedin.com/in/pan-jie-a70173b2</a
					>
				</p>
			</section>
		</main>
	</body>
</html>

<style>
	.home-blank {
		display: flex;
		min-height: calc(100vh - 5.15rem);
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		text-align: center;
		padding-top: 0.2rem;
	}

	.home-blank h1 {
		margin: 0;
		font-size: clamp(3.2rem, 9vw, 6rem);
		line-height: 0.95;
		letter-spacing: -0.02em;
	}

	/* "/writer" and " + Singapore" start collapsed and are slid out by GSAP.
	   clip-path (not overflow: hidden) hides the overflow sideways only, so tall letters
	   and descenders aren't cut and the words stay on the same baseline. */
	.slide {
		display: inline-block;
		width: 0;
		white-space: nowrap;
		clip-path: inset(-0.5em 0 -0.5em 0);
	}

	/* A slide placed before its word (the "{" in {data}): keep the text against the word,
	   so it grows out leftwards instead of rightwards */
	.slide-left {
		display: inline-flex;
		justify-content: flex-end;
	}

	.home-blank p {
		margin: 3.5rem 0 0;
		font-size: clamp(0.88rem, 1.2vw, 9rem);
		line-height: 1.3;
		word-spacing: 2rem;
	}

	.home-blank .lower {
		margin: 1rem 0 0;
		font-size: clamp(0.88rem, 1.2vw, 9rem);
		line-height: 1.3;
		word-spacing: 0.8rem;
	}

</style>

<script>
	import { gsap } from 'gsap';

	// Hovering a word (e.g. "London") slides out its extra text (" + Singapore"); leaving slides it back.
	const slides = document.querySelectorAll<HTMLElement>('.home-blank .slide');
	const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Width of a slide's text, measured directly (scrollWidth misses text that overflows leftwards, like the "{")
	const textWidth = (el: HTMLElement) => {
		const range = document.createRange();
		range.selectNodeContents(el);
		return range.getBoundingClientRect().width;
	};

	slides.forEach((slide) => {
		// Touch screens can't hover, so show the full text there
		if (!canHover) {
			slide.style.width = 'auto';
			return;
		}

		// The hover target is the whole phrase, so the cursor stays inside it as it grows
		const phrase = slide.parentElement;
		if (!phrase) return;

		phrase.addEventListener('mouseenter', () => {
			gsap.to(slide, {
				width: textWidth(slide),
				duration: reduceMotion ? 0 : 0.6,
				ease: 'power3.out',
				overwrite: true,
			});
		});
	});
</script>
