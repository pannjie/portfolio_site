---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Chronicle | ${SITE_TITLE}`} description="Embedded long-form investigative story." />
	</head>
	<body class="grid-page story-embed-page">
		<Header />
		<main>
			<section class="story-embed" aria-label="Embedded investigation story">
				<iframe
					title="Chronicle of a War Foretold"
					src="https://chronicle-of-a-death-foretold-production.up.railway.app/build_2/html/"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</section>
			
		</main>
	</body>
</html>

<style>
	.story-embed-page main {
		padding-top: 5.15rem;
	}

	.story-embed {
		width: 100%;
		background: #fafafa;
		border: 1px solid #e7e7e7;
	}

	.story-embed iframe {
		display: block;
		width: 100%;
		height: calc(100vh - 7.5rem);
		min-height: 640px;
		border: 0;
	}

	.story-fallback {
		margin-top: 0.45rem;
		font-size: 0.92rem;
		line-height: 1.35;
		color: rgba(var(--gray-dark), 0.9);
	}

	.story-fallback a {
		color: rgb(var(--gray-dark));
		font-weight: 700;
	}

	@media (max-width: 760px) {
		.story-embed-page main {
			padding-top: 0.75rem;
		}

		.story-embed iframe {
			height: calc(100vh - 6.2rem);
			min-height: 560px;
		}
	}
</style>
