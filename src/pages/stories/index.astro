---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import PentagramGrid from '../../components/PentagramGrid.astro';
import { SITE_TITLE } from '../../consts';
import cinemaHero from '../../assets/stories/cinema/battersea1.jpg';
import chronicleLaunchPoster from '../../assets/stories/chronicle/launch-poster.jpg';
import btrSkyline from '../../assets/stories/btr/elephant_castle.jpg';
import kopdes from '../../assets/stories/kopdes/kopdes.jpeg'
import midterms from '../../assets/stories/midterms/Screenshot 2026-11-15 at 19.27.01.png';

const stories = [
	{
		title: 'Chronicle of a War Foretold',
		label: 'Prediction markets',
		description: 'Investigative long-form visual story on prediction markets and conflict timing.',
		href: '/stories/chronicle/',
		video: {
			webm: '/media/stories/chronicle-launch.webm',
			mp4: '/media/stories/chronicle-launch.mp4',
			poster: chronicleLaunchPoster,
		},
	},
	{
		title: 'Cinema Enters Its Luxury Era',
		label: 'Business',
		description: 'Data story on why London’s premium cinemas are outgrowing their mainstream rivals.',
		href: '/stories/cinema-luxury/',
		image: cinemaHero,
	},
	{
		title: 'The Rise and Rise of London’s Build-to-Rent Empires',
		label: 'Property',
		description: 'Pet spas, private cinemas and in-house plumbers: who London’s new rental towers really serve.',
		href: '/stories/build-to-rent/',
		image: btrSkyline,
	},
	{
		title: 'Indonesia’s Risky $23bn Bet On The Village Economy',
		label: 'Asia',
		description: 'Can a chain of 83,363 cooperatives revive Southeast Asia’s largest economy?',
		href: '/stories/kopdes/',
		image: kopdes
	},
	{
		title: 'Why did Prediction Markets Lose Their Edge During the US Midterms',
		description: 'Prediction markets were supposed to beat political polling. If only.',
		label: 'Prediction markets',
		href: '/stories/midterms/',
		image: midterms,
	},
	{
		title: 'Magna aliqua enim ad',
		description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.',
		href: '/bio/',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Stories | ${SITE_TITLE}`} description="Stories." />
	</head>
	<body class="grid-page">
		<Header />
		<main>
			<PentagramGrid items={stories} />
		</main>
	</body>
</html>
