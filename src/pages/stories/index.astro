import { SITE_TITLE } from '../../consts';
import cinemaHero from '../../assets/stories/cinema/battersea1.jpg';
import chronicleLaunchPoster from '../../assets/stories/chronicle/launch-poster.jpg';

const stories = [
	{
		title: 'Chronicle of a War Foretold',
		label: 'Prediction markets',
		description: 'Investigative long-form visual story on prediction markets and conflict timing.',
		href: '/stories/chronicle/',
		video: {
			webm: '/media/stories/chronicle-launch.webm',
			mp4: '/media/stories/chronicle-launch.mp4',
			poster: chronicleLaunchPoster,
		},
	},
	{
		title: 'Cinema Enters Its Luxury Era',
		label: 'Business',
		description: 'Data story on why London’s premium cinemas are outgrowing their mainstream rivals.',
		href: '/stories/cinema-luxury/',
		image: cinemaHero,
	},
	{
		title: 'Consectetur adipiscing elit',
		description: 'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.',
		href: '/bio/',
	},
	{
		title: 'Sed do eiusmod tempor',
		description: 'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat.',
		href: '/about/',
	},
	{
		title: 'Ut labore et dolore',
		description: 'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt.',
		href: '/research/',
	},
	{
		title: 'Magna aliqua enim ad',
		description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.',
		href: '/bio/',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Stories | ${SITE_TITLE}`} description="Stories." />
	</head>
	<body class="grid-page">
		<Header />
		<main>
			<PentagramGrid items={stories} />
		</main>
	</body>
</html>
