---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import PentagramGrid from '../../components/PentagramGrid.astro';
import FallbackImage from '../../assets/blog-placeholder-about.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const interactives = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description,
	href: `/blog/${post.id}/`,
	image: post.data.heroImage ?? FallbackImage,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="grid-page">
		<Header />
		<main>
			<PentagramGrid items={interactives} />
		</main>
	</body>
</html>
