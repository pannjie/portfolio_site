---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import PentagramGrid from '../components/PentagramGrid.astro';
import { SITE_TITLE } from '../consts';
import sleepCover from '../assets/research/sleep/cottrell.webp';


const researchProjects = [
	{
		title: 'Geolocation of crypto wallets using sleep cycles',
		label: 'Prediction markets',
		description: 'Can you tell where a Polymarket trader lives from when they stop trading?',
		href: '/research/sleep-cycles/',
		image: sleepCover,
	},
	
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Research | ${SITE_TITLE}`} description="Research projects and methods." />
	</head>
	<body class="grid-page">
		<Header />
		<main>
			<PentagramGrid items={researchProjects} />
		</main>
	</body>
</html>
