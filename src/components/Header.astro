---
import HeaderLink from './HeaderLink.astro';
import { withBase } from '../utils/withBase';
---

<header class="site-header">
	<nav aria-label="Primary">
		<h2><a href={withBase('/')}>PJ</a></h2>
		<ul class="tree-view site-tree" role="tree" aria-label="Site pages">
			<li>
				<details open>
					<summary>Pages</summary>
					<ul>
						<li><HeaderLink href="/stories">Stories</HeaderLink></li>
						<li><HeaderLink href="/interactive">Interactive</HeaderLink></li>
						<li><HeaderLink href="/research">Research</HeaderLink></li>
						<li><HeaderLink href="/about">Past Lives</HeaderLink></li>
						<li><HeaderLink href="/cv">CV</HeaderLink></li>
						<li><HeaderLink href="/bio">Bio</HeaderLink></li>
					</ul>
				</details>
			</li>
		</ul>
	</nav>
</header>
<style>
	.site-header {
		position: fixed;
		inset: 3rem auto 0 var(--sidebar-left-offset);
		z-index: 20;
		box-sizing: border-box;
		width: var(--sidebar-width);
		padding: 2rem 1.25rem;
		background: #fff;
		font-family: 'Host Grotesk', 'Atkinson', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-weight: 400;
	}

	.site-header h2 {
		margin: 0;
		max-width: 7rem;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		line-height: 1.65;
		text-transform: uppercase;
	}

	.site-header h2 a,
	.site-header h2 a:hover,
	.site-header h2 a.active {
		color: inherit;
		text-decoration: none;
	}

	.site-header h2::after {
		display: block;
		width: 100%;
		margin-top: 0.75rem;
		border-bottom: 2px solid currentColor;
		content: '';
	}

	/*
	  Tree view adapted from 98.css v0.1.21 (only the rules this sidebar uses).
	  https://github.com/jdan/98.css
	  License MIT: https://github.com/jdan/98.css/blob/main/LICENSE
	 */
	.site-tree {
		display: block;
		margin: 0;
		padding: 0.42rem 0.2rem 0;
		font-family: 'VT323', 'Lucida Console', monospace;
		font-size: 1.06rem;
		line-height: 1.2;
		-webkit-font-smoothing: none;
	}

	.site-tree li {
		margin: 0.12rem 0;
		list-style-type: none;
	}

	.site-tree ul {
		margin-top: 3px;
		margin-left: 16px;
		padding-left: 16px;
		border-left: 1px dotted grey;
	}

	/* Dotted connector from the vertical guide to each item */
	.site-tree ul > li {
		position: relative;
	}

	.site-tree ul > li::before {
		content: '';
		display: block;
		position: absolute;
		top: 6px;
		left: -16px;
		width: 12px;
		border-bottom: 1px dotted grey;
	}

	/* Hide the vertical guide below the last item */
	.site-tree ul > li:last-child::after {
		content: '';
		display: block;
		position: absolute;
		top: 7px;
		bottom: 0;
		left: -20px;
		width: 8px;
		background: #fff;
	}

	.site-tree details {
		margin-top: 0;
	}

	.site-tree summary {
		display: flex;
		align-items: center;
		margin-bottom: 0;
		cursor: pointer;
		font-weight: 700;
	}

	.site-tree summary::marker,
	.site-tree summary::-webkit-details-marker {
		content: '';
	}

	.site-tree summary:focus {
		outline: 1px dotted #000;
	}

	/* Expand/collapse box, centred against the VT323 label */
	.site-tree summary::before {
		content: '+';
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 9px;
		height: 9px;
		margin-right: 5px;
		border: 1px solid grey;
		background-color: #fff;
		font-family: monospace;
		font-size: 11px;
		line-height: 1;
	}

	.site-tree details[open] > summary::before {
		content: '-';
	}

	.site-tree a {
		display: inline-block;
		color: #000;
		text-decoration: none;
		padding: 0 0.2rem;
	}

	.site-tree a:focus {
		outline: none;
	}

	/* GSAP animates hover/focus once ready; plain CSS is the no-JS fallback */
	.site-tree:not([data-gsap-ready]) a:hover,
	.site-tree:not([data-gsap-ready]) a:focus,
	.site-tree a.active {
		background: #000;
		color: #fff;
	}

	@media (max-width: 760px) {
		.site-header {
			inset: 0 0 auto;
			width: 100%;
			padding: 0.75rem 1.25rem;
			box-shadow: 0 2px 8px rgba(var(--black), 5%);
		}

		.site-tree {
			padding-top: 0.2rem;
		}

		.site-header h2::after {
			display: none;
		}
	}
</style>

<script type="module">
	import { gsap } from 'gsap';

	const tree = document.querySelector('.site-tree');

	if (tree && tree.dataset.gsapReady !== 'true') {
		tree.dataset.gsapReady = 'true';

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		tree.querySelectorAll('a:not(.active)').forEach((link) => {
			const enter = () => {
				gsap.to(link, {
					backgroundColor: '#000',
					color: '#fff',
					duration: reduceMotion ? 0 : 0.18,
					ease: 'power2.out',
					overwrite: 'auto',
				});
			};

			const leave = () => {
				if (document.activeElement === link || link.matches(':hover')) return;
				gsap.to(link, {
					backgroundColor: 'rgba(0, 0, 0, 0)',
					color: '#000',
					duration: reduceMotion ? 0 : 0.16,
					ease: 'power2.in',
					overwrite: 'auto',
				});
			};

			link.addEventListener('mouseenter', enter);
			link.addEventListener('mouseleave', leave);
			link.addEventListener('focus', enter);
			link.addEventListener('blur', leave);
		});
	}
</script>
