---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

	<header class="site-header">
	<nav>
		<h2>
			<a href="/">PJ</a>
		</h2>
		<button
			class="menu-toggle"
			type="button"
			aria-label="Open navigation menu"
			aria-expanded="false"
			aria-controls="primary-navigation"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>
		<div class="nav-content" id="primary-navigation">
			<div class="internal-links">
				<HeaderLink href="/">
					<span class="link-label">Stories</span>
					<span class="link-underline" aria-hidden="true"></span>
				</HeaderLink>
				<HeaderLink href="/blog">
					<span class="link-label">Interactives</span>
					<span class="link-underline" aria-hidden="true"></span>
				</HeaderLink>
				<HeaderLink href="/about">
					<span class="link-label">Past Lives</span>
					<span class="link-underline" aria-hidden="true"></span>
				</HeaderLink>
				<HeaderLink href="/research">
					<span class="link-label">Research</span>
					<span class="link-underline" aria-hidden="true"></span>
				</HeaderLink>
				<HeaderLink href="/cv">
					<span class="link-label">CV</span>
					<span class="link-underline" aria-hidden="true"></span>
				</HeaderLink>
				<HeaderLink href="/bio">
					<span class="link-label">Bio</span>
					<span class="link-underline" aria-hidden="true"></span>
				</HeaderLink>
			</div>
		</div>
	</nav>
</header>
<style>
	.site-header {
		position: fixed;
		inset: 3rem auto 0 var(--sidebar-left-offset);
		z-index: 20;
		box-sizing: border-box;
		width: var(--sidebar-width);
		padding: 2rem 1.25rem;
		background: #fff;
	}
	h2 {
		margin: 0;
		max-width: 7rem;
		font-size: 0.8rem;
		letter-spacing: 0.16em;
		line-height: 1.65;
		text-transform: uppercase;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1rem;
	}
	h2::after {
		display: block;
		width: 100%;
		margin-top: 0.75rem;
		border-bottom: 2px solid currentColor;
		content: '';
	}
	.nav-content,
	.internal-links {
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}
	.internal-links {
		gap: 0.25rem;
	}
	.internal-links a {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-start;
		width: fit-content;
	}
	nav a {
		padding: 0.1rem 0;
		color: rgb(var(--gray));
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
		text-decoration: none;
	}
	nav a.active {
		color: rgb(var(--gray-dark));
		font-weight: 800;
		text-decoration: none;
	}
	.link-label {
		display: inline-block;
	}
	.link-underline {
		display: block;
		width: 100%;
		margin-top: 0.2rem;
		border-top: 2px solid currentColor;
		transform: scaleX(0);
		transform-origin: right center;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.menu-toggle {
		display: none;
	}
	@media (max-width: 760px) {
		.site-header {
			inset: 0 0 auto;
			width: 100%;
			padding: 0.75rem 1.25rem;
			box-shadow: 0 2px 8px rgba(var(--black), 5%);
		}
		nav {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
		}
		h2 {
			max-width: 11rem;
		}
		h2::after {
			display: none;
		}
		.menu-toggle {
			display: flex;
			width: 2.75rem;
			height: 2.75rem;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 0.35rem;
			border: 0;
			background: transparent;
			cursor: pointer;
		}
		.menu-toggle span {
			display: block;
			width: 1.4rem;
			border-top: 2px solid currentColor;
		}
		.nav-content {
			display: none;
		}
		.site-header.is-open .nav-content {
			position: fixed;
			inset: 4.25rem 0 0;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 2rem;
			background: #fff;
		}
		.site-header.is-open .internal-links {
			align-items: center;
			gap: 1.25rem;
		}
		.site-header.is-open .internal-links a {
			align-items: center;
		}
		.site-header.is-open nav a {
			font-size: 1rem;
		}
		.social-links {
			display: none;
		}
	}
</style>
<script type="module">
	import { gsap } from 'gsap';

	const header = document.querySelector('.site-header');
	const menuToggle = header?.querySelector('.menu-toggle');
	const navigation = header?.querySelector('#primary-navigation');
	const sidebarLinks = navigation?.querySelectorAll('.internal-links > a') ?? [];

	sidebarLinks.forEach((link) => {
		const underline = link.querySelector('.link-underline');
		if (!underline) return;

		const isActive = link.classList.contains('active');
		gsap.set(underline, {
			scaleX: isActive ? 1 : 0,
			transformOrigin: isActive ? 'left center' : 'right center',
		});

		const showUnderline = () => {
			gsap.to(underline, {
				scaleX: 1,
				transformOrigin: 'left center',
				duration: 0.24,
				ease: 'power2.out',
				overwrite: 'auto',
			});
		};

		const hideUnderline = () => {
			if (link.classList.contains('active')) return;
			gsap.to(underline, {
				scaleX: 0,
				transformOrigin: 'right center',
				duration: 0.2,
				ease: 'power2.in',
				overwrite: 'auto',
			});
		};

		link.addEventListener('mouseenter', showUnderline);
		link.addEventListener('mouseleave', hideUnderline);
		link.addEventListener('focus', showUnderline);
		link.addEventListener('blur', hideUnderline);
	});

	function closeMenu() {
		header?.classList.remove('is-open');
		menuToggle?.setAttribute('aria-expanded', 'false');
		menuToggle?.setAttribute('aria-label', 'Open navigation menu');
	}

	menuToggle?.addEventListener('click', () => {
		const isOpen = header?.classList.toggle('is-open') ?? false;
		menuToggle.setAttribute('aria-expanded', String(isOpen));
		menuToggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
	});

	navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});
</script>
