---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { withBase } from '../utils/withBase';

type GridItem = {
	title: string;
	/** Short text for the dark box above the card; falls back to the title */
	label?: string;
	description: string;
	href: string;
	/** Optional card image in place of the gradient */
	image?: ImageMetadata;
	/** Optional short muted loop in place of the gradient; files live in public/ */
	video?: { webm: string; mp4: string; poster: ImageMetadata };
};

interface Props {
	items: GridItem[];
}

const { items } = Astro.props;

// Optimised poster frames, shown before a video loads and when motion is reduced
const posters = await Promise.all(
	items.map((item) => (item.video ? getImage({ src: item.video.poster, width: 768, format: 'webp' }) : undefined))
);
---

<section class="pentagram-grid">
	<div class="grid-list">
		{
			items.map((item, index) => (
				<article class="grid-item">
					<a class="project-card" href={withBase(item.href)}>
						<div class="card-topline" aria-hidden={item.label ? undefined : 'true'}>
							<span class="card-label">{item.label ?? item.title}</span>
						</div>
						<div class:list={["project-media", `gradient-${(index % 6) + 1}`]}>
							{item.video ? (
								<video
									class="card-video"
									autoplay
									muted
									loop
									playsinline
									preload="metadata"
									poster={posters[index]?.src}
									aria-hidden="true"
								>
									<source src={withBase(item.video.webm)} type="video/webm" />
									<source src={withBase(item.video.mp4)} type="video/mp4" />
								</video>
							) : (
								item.image && (
									<Image
										src={item.image}
										alt=""
										widths={[480, 768, 1152]}
										sizes="(max-width: 760px) 100vw, (max-width: 1080px) 50vw, 360px"
									/>
								)
							)}
							<div class="project-hover" aria-hidden="true"></div>
						</div>
						<div class="project-copy">
							<h2>{item.title}</h2>
							<p>{item.description}</p>
						</div>
					</a>
				</article>
			))
		}
	</div>
</section>

<script type="module">
	import { gsap } from 'gsap';

	const cards = document.querySelectorAll('.project-card');

	// Card videos: play only while on screen, and not at all when the reader prefers reduced motion
	const videos = document.querySelectorAll('.card-video');
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		videos.forEach((video) => {
			video.removeAttribute('autoplay');
			video.pause();
		});
	} else if ('IntersectionObserver' in window) {
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(({ target, isIntersecting }) => {
				if (isIntersecting) target.play().catch(() => {});
				else target.pause();
			});
		});
		videos.forEach((video) => observer.observe(video));
	}

	cards.forEach((card) => {
		if (card.dataset.gsapReady === 'true') return;
		card.dataset.gsapReady = 'true';

		const image = card.querySelector('.project-media');
		const overlay = card.querySelector('.project-hover');
		if (!image || !overlay) return;

		gsap.set(overlay, { autoAlpha: 0 });

		const enter = () => {
			gsap.to(overlay, {
				autoAlpha: 1,
				duration: 0.18,
				ease: 'power2.out',
				overwrite: 'auto',
			});
		};

		const leave = () => {
			gsap.to(overlay, {
				autoAlpha: 0,
				duration: 0.16,
				ease: 'power2.in',
				overwrite: 'auto',
			});
		};

		card.addEventListener('mouseenter', enter);
		card.addEventListener('mouseleave', leave);
		card.addEventListener('focusin', enter);
		card.addEventListener('focusout', leave);
	});
</script>