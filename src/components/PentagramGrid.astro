---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type GridItem = {
	title: string;
	description: string;
	href: string;
	image: ImageMetadata;
};

interface Props {
	items: GridItem[];
}

const { items } = Astro.props;
---

<section class="pentagram-grid">
	<div class="grid-list">
		{
			items.map((item) => (
				<article class="grid-item">
					<a class="project-card" href={item.href}>
						<div class="card-topline" aria-hidden="true">
							<span class="card-label">{item.title}</span>
						</div>
						<div class="project-media">
							<Image class="project-image" src={item.image} alt={item.title} width={960} height={640} />
							<div class="project-hover" aria-hidden="true">
								<span>View Project</span>
							</div>
						</div>
						<div class="project-copy">
							<h2>{item.title}</h2>
							<p>{item.description}</p>
						</div>
					</a>
				</article>
			))
		}
	</div>
</section>

<style>
	.pentagram-grid {
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		margin: 0;
		overflow-x: clip;
	}

	.grid-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.4rem;
	}

	.grid-item {
		min-width: 0;
	}

	.project-card {
		display: grid;
		grid-template-rows: auto auto 1fr;
		color: inherit;
		text-decoration: none;
		background-image: none;
		min-height: 100%;
		padding-left: 0.6rem;
		border-left: 1px solid rgba(var(--gray-dark), 0.35);
	}

	.card-topline {
		height: 1.9rem;
		display: flex;
		align-items: center;
	}

	.card-label {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		height: 1.3rem;
		padding: 0 0.42rem;
		background: rgb(var(--gray-dark));
		color: #fff;
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.project-media {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #efefef;
		margin-top: 0.2rem;
		max-width: 100%;
	}

	.project-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform-origin: center;
		will-change: transform;
		border-radius: 0;
	}

	.project-hover {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		justify-content: flex-start;
		padding: 1rem;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.58), rgba(0, 0, 0, 0.08));
		color: #fff;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		pointer-events: none;
		opacity: 0;
	}

	.project-copy {
		padding: 0.72rem 0.06rem 0.45rem;
		margin-top: 0.52rem;
	}

	h2 {
		margin: 0;
		font-size: clamp(1.04rem, 1.2vw, 1.36rem);
		line-height: 1.15;
		letter-spacing: 0.01em;
		text-wrap: balance;
	}

	p {
		margin-top: 0.3rem;
		margin-bottom: 0;
		font-size: clamp(0.82rem, 0.92vw, 0.98rem);
		line-height: 1.33;
		letter-spacing: 0.01em;
		color: rgb(var(--gray-dark));
		opacity: 0.87;
	}

	@media (max-width: 1080px) {
		.grid-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.12rem;
		}

		.project-copy {
			padding: 0.66rem 0.04rem 0.42rem;
		}
	}

	@media (max-width: 760px) {
		.grid-list {
			grid-template-columns: 1fr;
			gap: 0.95rem;
		}

		.card-topline {
			height: 1.75rem;
		}

		.project-copy {
			padding: 0.62rem 0.03rem 0.34rem;
		}
	}
</style>

<script type="module">
	import { gsap } from 'gsap';

	const cards = document.querySelectorAll('.project-card');

	cards.forEach((card) => {
		if (card.dataset.gsapReady === 'true') return;
		card.dataset.gsapReady = 'true';

		const image = card.querySelector('.project-image');
		const overlay = card.querySelector('.project-hover');
		if (!image || !overlay) return;

		gsap.set(overlay, { autoAlpha: 0, y: 10 });

		const enter = () => {
			gsap.to(image, {
				scale: 1.035,
				duration: 0.32,
				ease: 'power2.out',
				overwrite: 'auto',
			});
			gsap.to(overlay, {
				autoAlpha: 1,
				y: 0,
				duration: 0.26,
				ease: 'power2.out',
				overwrite: 'auto',
			});
		};

		const leave = () => {
			gsap.to(image, {
				scale: 1,
				duration: 0.3,
				ease: 'power2.out',
				overwrite: 'auto',
			});
			gsap.to(overlay, {
				autoAlpha: 0,
				y: 10,
				duration: 0.22,
				ease: 'power2.in',
				overwrite: 'auto',
			});
		};

		card.addEventListener('mouseenter', enter);
		card.addEventListener('mouseleave', leave);
		card.addEventListener('focusin', enter);
		card.addEventListener('focusout', leave);
	});
</script>