---
type GridItem = {
	title: string;
	description: string;
	href: string;
};

interface Props {
	items: GridItem[];
}

const { items } = Astro.props;
---

<section class="pentagram-grid">
	<div class="grid-list">
		{
			items.map((item, index) => (
				<article class="grid-item">
					<a class="project-card" href={item.href}>
						<div class="card-topline" aria-hidden="true">
							<span class="card-label">{item.title}</span>
						</div>
						<div class:list={["project-media", `gradient-${(index % 6) + 1}`]}>
							<div class="project-hover" aria-hidden="true"></div>
						</div>
						<div class="project-copy">
							<h2>{item.title}</h2>
							<p>{item.description}</p>
						</div>
					</a>
				</article>
			))
		}
	</div>
</section>

<script type="module">
	import { gsap } from 'gsap';

	const cards = document.querySelectorAll('.project-card');

	cards.forEach((card) => {
		if (card.dataset.gsapReady === 'true') return;
		card.dataset.gsapReady = 'true';

		const image = card.querySelector('.project-media');
		const overlay = card.querySelector('.project-hover');
		if (!image || !overlay) return;

		gsap.set(overlay, { autoAlpha: 0 });

		const enter = () => {
			gsap.to(overlay, {
				autoAlpha: 1,
				duration: 0.18,
				ease: 'power2.out',
				overwrite: 'auto',
			});
		};

		const leave = () => {
			gsap.to(overlay, {
				autoAlpha: 0,
				duration: 0.16,
				ease: 'power2.in',
				overwrite: 'auto',
			});
		};

		card.addEventListener('mouseenter', enter);
		card.addEventListener('mouseleave', leave);
		card.addEventListener('focusin', enter);
		card.addEventListener('focusout', leave);
	});
</script>