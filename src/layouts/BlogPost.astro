---
import ArticleHeader from '../components/ArticleHeader.astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';

interface Props {
	title: string;
	/** Italic intro line, also used for search results and link previews */
	description?: string;
	/** Filled box above the title */
	label?: string;
	pubDate?: Date;
	updatedDate?: Date;
	/** Show dates as Oct 22, 2026 (day, default) or Oct 2026 (month) */
	datePrecision?: 'day' | 'month';
}

const { title, description, label, pubDate, updatedDate, datePrecision } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description ?? SITE_DESCRIPTION} />
	</head>

	<body class="grid-page">
		<Header />
		<main>
			<article class="page-article">
				<ArticleHeader
					label={label}
					title={title}
					pubDate={pubDate}
					updatedDate={updatedDate}
					datePrecision={datePrecision}
				/>
				<div class="article-body">
					{description && <p class="intro">{description}</p>}
					<slot />
				</div>
			</article>
		</main>
	</body>
</html>

<style>
	.page-article {
		padding-bottom: 4rem;
	}

	/* Text column: site reading width with a rule down the left edge */
	.article-body {
		box-sizing: border-box;
		max-width: 720px;
		margin: 4rem auto 0;
		padding-left: 0.6rem;
		border-left: 1px solid rgba(var(--gray-dark), 0.6);
	}

	.article-body :global(p) {
		margin: 0 0 1em;
		font-size: 1.1rem;
		line-height: 1.45;
		letter-spacing: 0.01em;
	}

	.article-body .intro {
		margin-bottom: 3rem;
		font-style: italic;
	}

	.article-body :global(h2) {
		margin: 3rem 0 0.9rem;
		font-size: clamp(2.4rem, 4.2vw, 3.6rem);
		font-weight: 500;
		line-height: 0.95;
		letter-spacing: -0.035em;
	}

	.article-body :global(h3) {
		margin: 2.4rem 0 0.7rem;
		font-size: 1.75rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	.article-body > :global(:first-child + h2) {
		margin-top: 0;
	}

	@media (max-width: 760px) {
		.article-body {
			margin-top: 2.5rem;
		}
	}
</style>
